# 本地 AI Telegram Bot - 環境變數範本
# 複製此檔案為 .env 並填入您的設定

# === Telegram Bot 設定 (必填) ===
# 從 @BotFather 取得
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuvwx

# 授權使用者 Telegram User ID (必填，多個用逗號分隔)
# 從 @userinfobot 查詢
ALLOWED_USER_IDS=123456789,987654321

# === Ollama / 本地模型設定 ===
# Ollama 服務位址 (用 127.0.0.1，避免 macOS 偶發 localhost 解析失敗)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 要使用的模型 (需支援 Function Calling)
# 建議：llama3.1, llama3.2, nemotron3-ultra, command-r, command-r-plus
OLLAMA_MODEL=llama3.1

# 模型回應逾時秒數
OLLAMA_TIMEOUT=120

# 模型上下文長度 (tokens)，Ollama 預設僅 2048~4096，搜尋結果易被截斷
# 數值越大越吃記憶體 (llama3.1 最大 131072)
OLLAMA_NUM_CTX=8192

# === 搜尋設定 ===
# 搜尋引擎: duckduckgo | google_news | ddgs (其他值啟動時會報錯)
SEARCH_ENGINE=duckduckgo

# 備援搜尋引擎：主引擎無結果或 DuckDuckGo 被機器人驗證擋下時改用 (留空停用)
# ddgs = 多引擎 (Bing/Brave/Google/Mojeek/Yahoo... 自動切換)，google_news 僅新聞
SEARCH_FALLBACK_ENGINE=ddgs

# 搜尋後讀取前 N 筆結果的網頁內文給模型 (0 = 只用搜尋摘要)
SEARCH_FETCH_PAGES=2

# 每頁內文摘錄上限字數 (越大越完整，但會佔用 OLLAMA_NUM_CTX)
SEARCH_PAGE_CHARS=1500

# 每次搜尋最大結果數
SEARCH_MAX_RESULTS=4

# 搜尋判斷方式: router | tools
# router：模型先輸出 JSON 判斷是否需要搜尋 (預設，適用 llama3.1 / qwen2.5)
# tools ：原生 Function Calling，模型自行呼叫工具 (llama3.1 會「每題都搜」，建議搭配 gemma4)
SEARCH_DECISION=router

# 搜尋請求逾時秒數
SEARCH_TIMEOUT=15

# === 對話設定 ===
# 保留對話輪數 (每輪 = 1 問 + 1 答)
MAX_HISTORY_TURNS=4

# === 配額設定 ===
# 每日最大請求次數
MAX_DAILY_REQUESTS=50

# === 日誌設定 ===
LOG_LEVEL=INFO

# === Webhook 設定 (選用，使用 polling 模式可忽略) ===
# WEBHOOK_URL=https://your-domain.com/webhook
# WEBHOOK_PORT=8443
# WEBHOOK_HOST=0.0.0.0